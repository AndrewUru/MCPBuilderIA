<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/color_surface</item>
        <item name="android:navigationBarColor">@color/color_surface</item>
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_ink</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSurface">@color/color_card</item>
        <item name="colorOnPrimary">@color/color_card</item>
        <item name="colorOnSecondary">@color/color_card</item>
        <item name="colorOnSurface">@color/color_ink</item>
        <item name="materialButtonStyle">@style/Widget.McpBuilder.Button</item>
    </style>

    <style name="Widget.McpBuilder.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="AppTheme.Splash" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/color_surface</item>
        <item name="android:navigationBarColor">@color/color_surface</item>
    </style>
</resources>
